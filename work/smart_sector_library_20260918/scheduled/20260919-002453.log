s():\n   data=json.loads(candidate.read_text(encoding='utf-8'))\n   if data.get('status')=='read':\n    assert row['id'][:6] in data['source_url'];ths_path=candidate;break\n assert ths_path\n source_manifest.append({'instrument_id':row['id'],'company_path':str(company_path),'company_file_sha256':hashlib.sha256(company_path.read_bytes()).hexdigest(),'ths_path':str(ths_path),'ths_file_sha256':hashlib.sha256(ths_path.read_bytes()).hexdigest()})\nassert target.read_bytes()==before_bytes\nprint('PREFLIGHT_OK',len(batch),'verified',sum(bool(row.get('sector')) for row in batch),'gaps',sum(bool(row.get('gap')) for row in batch),flush=True)\ncompleted=subprocess.run([sys.executable,str(root/'publish-review-batch.py'),str(batch_path)],capture_output=True,text=True,encoding='utf-8')\nprint('PUBLISH_EXIT',completed.returncode,'STDOUT',completed.stdout.strip(),'STDERR',completed.stderr.strip(),flush=True)\nif completed.returncode:raise SystemExit(completed.returncode)\nafter=json.loads(target.read_text(encoding='utf-8'))\nassert after['entries'][:len(before['entries'])]==before['entries']\nassert {k:v for k,v in before.items() if k\"'!='\"'entries'}=={k:v for k,v in after.items() if k\"'!='\"'entries'}\nassert [entry['instrument_id'] for entry in after['entries'][len(before['entries']):]]==[row['id'] for row in batch]\nreceipt={'checked_at':datetime.now(ZoneInfo('Asia/Shanghai')).isoformat(),'batch_path':str(batch_path),'batch_sha256':hashlib.sha256(batch_path.read_bytes()).hexdigest(),'frozen_universe_total':len(stocks),'index_start':95,'index_end_inclusive':114,'reviewed_added':len(batch),'verified_added':sum(bool(row.get('sector')) for row in batch),'pending_reviews_added':sum(bool(row.get('gap')) for row in batch),'reviewed_before':len(before['entries']),'reviewed_after':len(after['entries']),'prior_entries_unchanged':True,'prior_envelope_unchanged':True,'evidence_sha256_before':hashlib.sha256(before_bytes).hexdigest(),'evidence_sha256_after':hashlib.sha256(target.read_bytes