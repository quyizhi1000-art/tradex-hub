{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"\"C:\\\\Users\\\\Admin\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command '$patch = @'\"'\n*** Begin Patch\n*** Add File: G:/money/work/smart_sector_library_20260918/scheduled/review-scheduled-20260919-003400.json\n+[\n+  {\n+    \\\"id\\\": \\\"000510.SZ\\\",\n+    \\\"fact\\\": \\\"经营氯碱化工，同时推进栗木矿复产和采选冶建设。\\\",\n+    \\\"ths_fact\\\": \\\"PVC解析列示聚氯乙烯树脂和烧碱；小金属解析提及栗木矿钨锡钽铌铷产品及2023年稀有金属合作框架；金属铜解析沿用2022至2023年矿业资料。\\\",\n+    \\\"company_fact\\\": \\\"公司业务资料列示树脂差异化、碱产品高端化和电石渣一期投产；栗木矿仍推进复产及采选冶项目前期工作，融资2.35亿元用于建设增储。\\\",\n+    \\\"gap\\\": \\\"矿业解析与当前推进复产建设的表述存在关键阶段差异，不能把规划产能当投产。须复核最新复产、采选冶投产及增资后权益公告，再补小金属相对氯碱的持续市场认知；合作框架和旧石墨烯技术成果不能单独确定主线。本轮未打开原公告，纳入后续复核。\\\"\n+  },\n+  {\n+    \\\"id\\\": \\\"000513.SZ\\\", \\\"key\\\": \\\"pharmaceutical_manufacturing\\\", \\\"sector\\\": \\\"医药制造\\\",\n+    \\\"chain\\\": [\\\"药品研发与生产\\\", \\\"化学药及生物药制剂\\\", \\\"原料药与中间体\\\"], \\\"basis\\\": \\\"crosschecked_sources\\\",\n+    \\\"fact\\\": \\\"经营药品研发生产销售，覆盖化学药、生物药、中药制剂和原料药等。\\\",\n+    \\\"ths_fact\\\": \\\"解析列示替硝唑片通过一致性评价、艾普拉唑钠纳入医保及宠物制剂陆续获批；创新药和疫苗包含临床管线，AI用于研发生产销售流程。\\\",\n+    \\\"company_fact\\\": \\\"公司业务资料明确其为集医药研发生产销售于一体的集团，覆盖化学药、生物药、中药制剂、原料药及中间体、诊断试剂与设备。\\\",\n+    \\\"reason\\\": \\\"多个药品主题有具体产品和制药经营支撑，可收敛于医药制造，而不是按某一疾病标签排序。临床管线不当已销售产品，过去预计获批年份不当实际批准；AI属于自身经营赋能，不发布AI主归属，诊断与中药保留业务背景。\\\"\n+  },\n+  {\n+    \\\"id\\\": \\\"000514.SZ\\\", \\\"key\\\": \\\"real_estate\\\", \\\"sector\\\": \\\"房地产\\\",\n+    \\\"chain\\\": [\\\"住宅与商业地产开发\\\", \\\"存量商业运营\\\"], \\\"basis\\\": \\\"crosschecked_sources\\\",\n+    \\\"fact\\\": \\\"在重庆开展房地产开发销售和存量商业运营。\\\",\n+    \\\"ths_fact\\\": \\\"物业管理、重庆自贸区和成渝特区解析均说明房地产开发销售及经营，另列物业、租赁和会展服务。\\\",\n+    \\\"company_fact\\\": \\\"公司业务资料列明房地产开发销售，项目集中重庆主城，住宅及社区商业为主要类型，目前以商品房销售和存量商业运营为主。\\\",\n+    \\\"reason\\\": \\\"不同主题解析共同指向有实际项目支撑的地产开发运营，不按首项取物业管理；区域与国企属性不另作产业主线。\\\"\n+  },\n+  {\n+    \\\"id\\\": \\\"000516.SZ\\\", \\\"key\\\": \\\"medical_services\\\", \\\"sector\\\": \\\"医疗服务\\\",\n+    \\\"chain\\\": [\\\"综合医院运营\\\", \\\"专科诊疗与康复服务\\\"], \\\"basis\\\": \\\"crosschecked_sources\\\",\n+    \\\"fact\\\": \\\"运营综合医疗机构，提供诊疗、专科及康复服务。\\\",\n+    \\\"ths_fact\\\": \\\"解析说明互联网医院问诊、处方配送、慢病随访和旗下医院康复、导诊、手术机器人的使用；华为合作用于智慧医院建设。\\\",\n+    \\\"company_fact\\\": \\\"公司业务资料明确目前运营西安高新医院、西安国际医学中心医院两大综合机构，以综合医疗加特色专科模式提供服务。\\\",\n+    \\\"reason\\\": \\\"双源支持医院诊疗服务主线。AI、华为合作及机器人用于医院经营，不等于销售AI系统或制造机器人；当前机构按公司资料列示两院，不沿用旧商洛医院和商业零售背景，细胞研究也不等于药品生产。\\\"\n+  }\n+]\n*** End Patch\n'@; apply_patch \"'$patch'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
