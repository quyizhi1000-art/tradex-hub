+.appearance-panel { width: 680px; inset-inline-start: min(max(20px, calc((100vw - 1660px) / 2 + 385px)), calc(100vw - 700px)); padding: 24px; box-shadow: 0 18px 60px rgba(0, 0, 0, .18); }
+.appearance-heading h2 { font-weight: 600; letter-spacing: -.02em; }
+.appearance-choice { gap: 7px; padding: 12px; }
+.appearance-choice strong { font-weight: 600; }
+.appearance-choice small { font-size: 11px; line-height: 1.6; }
+.appearance-fieldset legend { font-size: 12px; font-weight: 500; }
+.appearance-recommended { padding: 2px 5px; border-radius: 4px; background: var(--cyan-soft); color: var(--cyan); font-size: 10px; font-weight: 500; }
+.appearance-previous { margin-top: 14px; }
+.appearance-previous > summary { width: fit-content; margin-bottom: 10px; font-size: 12px; color: var(--text-soft); cursor: pointer; }
+.appearance-swatch--editorial { height: 116px; grid-template-rows: auto 1fr 22px; padding: 12px; gap: 7px; }
+.appearance-swatch--editorial b { grid-column: 1 / -1; color: var(--sample-accent); font-family: "Segoe UI", sans-serif; font-size: 9px; font-weight: 600; letter-spacing: .09em; }
+.appearance-swatch--editorial em { grid-column: 1 / -1; align-self: center; color: var(--sample-text); font-style: normal; font-size: 18px; font-weight: 500; letter-spacing: -.03em; }
+.appearance-fonts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
+.appearance-font-sample { display: block; margin: 4px 0 8px; font-size: 19px; font-weight: 400; }
+.appearance-font-sample em { display: block; margin-top: 4px; font-size: 15px; font-style: normal; color: var(--text-soft); letter-spacing: .03em; }