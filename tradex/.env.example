# tradex 环境变量配置模板
# 复制为 .env 并根据需要修改，不配置也可正常运行（使用默认值）

# ── 数据源 ──────────────────────────────────────────────
# AKShare 请求超时时间（秒）
AKSHARE_TIMEOUT=30
# 腾讯行情接口超时时间（秒）
TENCENT_TIMEOUT=10
# 通达信服务器地址，auto 表示自动选择最优
ELTDX_SERVER=auto

# Tushare Pro 兼容付费源（token 仅从 TUSHARE_TOKEN 环境变量或外部文件读取）
TUSHARE_ENABLED=true
TUSHARE_BASE_URL=https://api.tushare.pro
# 推荐只配置外部密钥文件；相对路径按 tradex 项目目录、仓库目录依次解析
TUSHARE_TOKEN_FILE=
TUSHARE_TIMEOUT=15
TUSHARE_MAX_INFLIGHT=4
# 共享限流按实际权限产品分桶；实时 A 股、ETF、申万各自使用独立 50/min 桶
TUSHARE_POINTS_RATE_LIMIT_PER_MINUTE=500
TUSHARE_REALTIME_DAILY_RATE_LIMIT_PER_MINUTE=50
TUSHARE_REALTIME_MINUTE_RATE_LIMIT_PER_MINUTE=500
TUSHARE_AUCTION_RATE_LIMIT_PER_MINUTE=500
# 仅把已验证且语义等价的能力设为主源；删除单项即可独立回滚。
# sector_quotes 对应单独授权的 rt_sw_k；当前账号未开通，故默认不启用。
TUSHARE_PRIMARY_CAPABILITIES=realtime_quote,historical_kline,auction_data,market_universe,etf_quotes,stock_fund_flow,dragon_tiger_market_day,minute_data,instrument_taxonomy
# 统一证券关系目录默认写入 ~/.tradex/instrument_taxonomy.sqlite3；仅测试或迁移时覆盖
TRADEX_INSTRUMENT_TAXONOMY_DB=

# 同花顺金融数据 API（官方变量优先，旧变量保持兼容）
FUYAO_BASE_URL=https://fuyao.aicubes.cn
HITHINK_FINANCE_API_KEY=
# 兼容旧配置；与 HITHINK_FINANCE_API_KEY 二选一
FUYAO_API_KEY=
# 推荐在本地文件中保存密钥；相对路径按 tradex 项目目录解析
FUYAO_API_KEY_FILE=
FUYAO_TIMEOUT=15
FUYAO_MAX_INFLIGHT=4
# 扶摇未公开统一频次；这是跨进程本地安全预算，可按实际合同覆盖
FUYAO_RATE_LIMIT_PER_MINUTE=300

# 必盈付费数据源（许可证不会写入日志；推荐只配置本地文件）
BIYING_ENABLED=true
BIYING_BASE_URL=https://api.biyingapi.com
BIYING_LICENCE=
# 相对路径按 tradex 项目目录、仓库目录依次解析
BIYING_LICENCE_FILE=../key/必营key.txt
BIYING_TIMEOUT=15
BIYING_MAX_INFLIGHT=4
# 普通证书默认 300 次/分钟；所有本机 Tradex 进程共享
BIYING_RATE_LIMIT_PER_MINUTE=300
# 删除某一项即可把该能力回滚到 Fuyao/原有源
BIYING_PRIMARY_CAPABILITIES=realtime_quote,historical_kline,market_overview,index_daily_amount,all_a_shares,full_kline,adjusted_kline,company_info,financial_stmt,finance_report,valuation,dividend_financing,industry_data,concept_attribution,limit_up_board,fund_hold

# ── 免费源防封预算（与付费源完全独立）──────────────────
# 东财：所有本机 Tradex 进程共享一个 IP 请求时间线
EM_RATE_LIMIT_INTERVAL=1.0
# 随机抖动范围（秒），默认 0.1~0.5
EM_JITTER_MIN=0.1
EM_JITTER_MAX=0.5
# 403 Forbidden 时最大重试次数，默认 1
EM_MAX_RETRY=1
# 预计排队超过该秒数时立即切换备用源，避免占满 MCP worker
# 覆盖一次有序看板批次，同时保持有界等待
EM_MAX_QUEUE_WAIT=8.0
# AKShare：按一次逻辑 provider 调用计数，避免多个进程同时轰击上游免费站点
AKSHARE_RATE_LIMIT_INTERVAL=1.0
AKSHARE_MAX_QUEUE_WAIT=8.0
# 腾讯行情免费兜底
TENCENT_RATE_LIMIT_INTERVAL=0.5
TENCENT_MAX_QUEUE_WAIT=4.0
# 同花顺零鉴权网页接口
THS_FREE_RATE_LIMIT_INTERVAL=0.5
THS_FREE_MAX_QUEUE_WAIT=4.0
# 低频免费资讯/查询站点；分别计数，互不挤占
CLS_FREE_RATE_LIMIT_INTERVAL=1.0
CLS_FREE_MAX_QUEUE_WAIT=4.0
CNINFO_FREE_RATE_LIMIT_INTERVAL=1.0
CNINFO_FREE_MAX_QUEUE_WAIT=4.0
SINA_FREE_RATE_LIMIT_INTERVAL=1.0
SINA_FREE_MAX_QUEUE_WAIT=4.0
IWENCAI_FREE_RATE_LIMIT_INTERVAL=2.0
IWENCAI_FREE_MAX_QUEUE_WAIT=6.0

# 可选：共享状态默认写入 %LOCALAPPDATA%/Tradex；覆盖时必须使用绝对路径
# TRADEX_RATE_LIMIT_STATE_FILE=C:\path\to\provider-rate-limits.sqlite3

# ── 智能路由 ────────────────────────────────────────────
# 健康检查间隔（秒）
ROUTER_HEALTH_CHECK_INTERVAL=60
# 数据源最低健康评分，低于此值不再选中
ROUTER_MIN_SCORE=20.0
# 定时恢复评分的增量
ROUTER_RECOVERY_AMOUNT=10.0
# 单次 SmartRouter 请求的总 deadline（秒，覆盖全部 fallback）
TRADEX_ROUTE_DEADLINE_SECONDS=30
# 单个供应商尝试的总 deadline（秒，覆盖排队、请求和校验）
TRADEX_PROVIDER_DEADLINE_SECONDS=15
# 全局同时运行或等待结束的供应商调用上限
TRADEX_MAX_PROVIDER_CALLS=8

# ── MCP 服务 ────────────────────────────────────────────
# MCP 传输模式：stdio | sse | http
MCP_TRANSPORT=stdio
# MCP HTTP/SSE 模式监听地址
MCP_HOST=127.0.0.1
# MCP HTTP/SSE 模式监听端口
MCP_PORT=8000
# MCP 阻塞工具的进程级最大并发数
TRADEX_MCP_MAX_BLOCKING_CALLS=8
# MCP 工具从排队到完成的端到端 deadline（秒）
TRADEX_MCP_REQUEST_DEADLINE_SECONDS=45

# ── 缓存 ────────────────────────────────────────────────
# 内存缓存最大条目数，0 表示无限
CACHE_MAX_SIZE=5000
# 文件缓存目录路径
CACHE_FILE_DIR=.cache
# 是否启用文件缓存
CACHE_FILE_ENABLED=true

# ── 技术分析 ────────────────────────────────────────────
# 技术指标计算回溯天数
INDICATOR_LOOKBACK_DAYS=400
# 筹码分布直方图分箱数
CHIP_DISTRIBUTION_BINS=50

# ── 日志 ────────────────────────────────────────────────
# 日志级别：DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# 日志文件目录
LOG_DIR=logs

# ── 数据湖（可选，启用独立实时沉淀 / CNEquity 只读查询） ─────────
# Tradex 实时观测、特征、shadow 决策和回放目录
TRADEX_DATA_LAKE_ROOT=G:\money\.tradex-run\lake
# CNEquity 配置文件中 [data].root 的实际目录
CNEQUITY_DATA_ROOT=G:\CNEquity\data\cnequity
# 生产采集建议由构建/发布流程注入可定位的 Git SHA
TRADEX_CODE_SHA=
